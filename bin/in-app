#!/bin/sh
set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

in_docker() {
    [ -f /.dockerenv ] || [ -f /run/.containerenv ]
}

if in_docker; then
    exec "$@"
fi

if ! docker info >/dev/null 2>&1; then
    echo "Docker не запущен." >&2
    exit 1
fi

if [ -t 0 ] && [ -t 1 ]; then
    exec docker compose run --rm php "$@"
fi

exec docker compose run --rm -T php "$@"
