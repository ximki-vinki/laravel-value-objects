{
    "name": "ximki-vinki/laravel-value-objects",
    "description": "A bunch of general-purpose value objects you can use in your Laravel application.",
    "keywords": [
        "ximki-vinki",
        "laravel",
        "laravel-value-objects",
        "value-objects"
    ],
    "homepage": "https://github.com/ximki-vinki/laravel-value-objects",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Rubél",
            "email": "contact@observer.name",
            "role": "Original Author"
        },
        {
            "name": "Ilia Manyutin",
            "email": "ximki0vinki@gmail.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0",
        "phpmath/bignumber": "^1.2",
        "spatie/laravel-package-tools": "^1.12"
    },
    "require-dev": {
        "infection/infection": "^0.32",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "XimkiVinki\\ValueObjects\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XimkiVinki\\ValueObjects\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "bin/in-app ./vendor/bin/pest"
        ],
        "test-coverage": [
            "Composer\\Config::disableProcessTimeout",
            "bin/in-app ./vendor/bin/pest --coverage-html=coverage"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "infection/extension-installer": true
        },
        "platform": {
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "XimkiVinki\\ValueObjects\\ValueObjectServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
